# ---- LLM（OpenAI 兼容协议，可换 GLM/Qwen 等）----
# 复制本文件为 .env 并按需填写真实值
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_MODEL=doubao-seed-2.0-mini
# 思考模式关闭(doubao-seed)；设为 1 关闭，普通模型可删此行
LLM_THINKING_OFF=1

# ---- 魔珐星云（真机联调启用）----
XMOV_APP_ID=your_xmov_app_id_here
XMOV_APP_SECRET=your_xmov_app_secret_here
XMOV_WS_URL=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session

# ---- 星云形象/音色（非密钥资产 ID，公开无妨，随时可换）----
XMOV_LAOZHANG_AVATAR=AM032_V2_14200_new
XMOV_LAOZHANG_VOICE=XMOV_HN_TTS__36
XMOV_XIAOYA_AVATAR=AF045_8752_new
XMOV_XIAOYA_VOICE=XMOV_HN_TTS__49

# ---- 国内构建加速（可选：留空/删除即用官方源）----
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
